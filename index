<!DOCTYPE html>
<html>
<head>
  <base target="_top">
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Compliance Activity</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&display=swap" rel="stylesheet">
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: 'Inter', sans-serif; background: linear-gradient(135deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%); color: #f8fafc; }
    .glass { background: rgba(255, 255, 255, 0.05); backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.1); }
    .sidebar { width: 260px; transition: width 0.3s; }
    .sidebar.collapsed { width: 72px; }
    .sidebar.collapsed .sidebar-text, .sidebar.collapsed .sidebar-label { display: none; }
    .sidebar.collapsed .logo-img { display: block !important; }
    .logo-img { display: none; }
    .main-content { margin-left: 260px; transition: margin-left 0.3s; }
    .sidebar.collapsed ~ .main-content { margin-left: 72px; }
    .nav-item { display: flex; align-items: center; padding: 12px 16px; margin: 4px 8px; border-radius: 8px; cursor: pointer; }
    .nav-item:hover { background: rgba(255, 255, 255, 0.1); }
    .nav-item.active { background: linear-gradient(135deg, #00d4aa 0%, #9d4edd 100%); }
    .page { display: none; }
    .page.active { display: block; }
    .modal { position: fixed; inset: 0; background: rgba(0,0,0,0.7); display: none; justify-content: center; align-items: center; z-index: 9999; }
    .modal.active { display: flex; }
    input, select { background: rgba(0,0,0,0.3) !important; border: 1px solid rgba(255,255,255,0.1) !important; color: white !important; }
    input:focus { border-color: #00d4aa !important; outline: none; }
  </style>
</head>
<body>

  <!-- LOGIN PAGE -->
  <div id="login-page" class="min-h-screen flex items-center justify-center p-4">
    <div class="glass rounded-2xl w-full max-w-md p-8">
      <div class="text-center mb-8">
        <img src="https://i.imgur.com/G72tCKg.png" alt="Logo" class="w-20 h-20 mx-auto mb-4 object-contain">
        <h1 class="text-3xl font-bold bg-gradient-to-r from-[#00d4aa] to-[#ff6b9d] bg-clip-text text-transparent">Compliance Activity</h1>
      </div>
      <form onsubmit="handleLogin(event)">
        <div class="mb-6">
          <label class="block text-sm font-semibold mb-2">Username atau Email</label>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-500">person</span>
            <input type="text" id="login-id" class="w-full pl-10 pr-4 py-3 rounded-lg" placeholder="Masukkan username atau email" required>
          </div>
        </div>
        <div class="mb-6">
          <label class="block text-sm font-semibold mb-2">Password</label>
          <div class="relative">
            <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-500">lock</span>
            <input type="password" id="login-pass" class="w-full pl-10 pr-12 py-3 rounded-lg" placeholder="••••••••" required>
            <span class="material-symbols-outlined absolute right-3 top-1/2 -translate-y-1/2 cursor-pointer text-slate-500" onclick="togglePassword()" id="toggle-icon">visibility</span>
          </div>
        </div>
        <button type="submit" class="w-full bg-gradient-to-r from-[#00d4aa] to-[#9d4edd] text-white font-bold py-3 rounded-lg">Sign In</button>
      </form>
    </div>
  </div>

  <!-- MAIN APP -->
  <div id="main-app" class="hidden min-h-screen flex">
    <aside class="sidebar fixed left-0 top-0 h-full glass flex flex-col" id="sidebar">
      <div class="h-16 flex items-center px-6 justify-between border-b border-white/10">
        <div class="flex items-center gap-3">
          <img src="https://i.imgur.com/G72tCKg.png" alt="Logo" class="w-8 h-8 logo-img object-contain">
          <span class="font-bold text-lg bg-gradient-to-r from-[#00d4aa] to-[#ff6b9d] bg-clip-text text-transparent sidebar-text">Compliance</span>
        </div>
        <button onclick="toggleSidebar()" class="p-1 hover:bg-white/10 rounded"><span class="material-symbols-outlined">chevron_left</span></button>
      </div>
      <nav class="flex-1 py-4 overflow-y-auto" id="sidebar-menu"></nav>
      <div class="p-4 border-t border-white/10">
        <div class="nav-item text-red-400 hover:bg-red-500/10" onclick="showLogoutModal()">
          <span class="material-symbols-outlined mr-3">logout</span>
          <span class="sidebar-text">Logout</span>
        </div>
      </div>
    </aside>

    <div class="main-content flex-1">
      <header class="fixed top-0 right-0 left-[260px] h-16 glass border-b border-white/10 flex items-center justify-between px-8 z-40" id="header">
        <div class="flex items-center gap-4">
          <div>
            <div class="text-sm font-semibold" id="header-name">User</div>
            <div class="text-xs text-slate-400" id="header-role">Role</div>
          </div>
          <div id="header-avatar" class="w-10 h-10 rounded-full bg-gradient-to-br from-[#00d4aa] to-[#9d4edd] flex items-center justify-center font-bold">U</div>
        </div>
      </header>

      <main class="pt-20 p-8">
        <div id="page-dashboard" class="page active">
          <h1 class="text-3xl font-bold mb-6">Dashboard</h1>
          <div class="glass p-8 rounded-2xl text-center text-slate-400">Selamat datang di Compliance Activity</div>
        </div>
        <div id="page-tasks" class="page">
          <h1 class="text-3xl font-bold mb-6">Task Management</h1>
          <div class="glass p-8 rounded-2xl">Dalam Pengembangan</div>
        </div>
        <div id="page-repository" class="page">
          <h1 class="text-3xl font-bold mb-6">Repository</h1>
          <div class="glass p-8 rounded-2xl">Dalam Pengembangan</div>
        </div>
        <div id="page-team-okr" class="page">
          <h1 class="text-3xl font-bold mb-6">Team OKR</h1>
          <div class="glass p-8 rounded-2xl">Dalam Pengembangan</div>
        </div>
        <div id="page-config-users" class="page">
          <h1 class="text-3xl font-bold mb-6">User Management</h1>
          <div class="glass p-8 rounded-2xl">User Management - Coming Soon</div>
        </div>
        <div id="page-config-menu" class="page">
          <h1 class="text-3xl font-bold mb-6">Menu Settings</h1>
          <div class="glass p-8 rounded-2xl">Menu Configuration - Coming Soon</div>
        </div>
      </main>
    </div>
  </div>

  <!-- LOGOUT MODAL -->
  <div id="logout-modal" class="modal">
    <div class="glass rounded-2xl p-8 max-w-md w-full mx-4 text-center">
      <div class="w-20 h-20 bg-orange-500/20 rounded-full flex items-center justify-center mx-auto mb-4">
        <span class="material-symbols-outlined text-orange-400 text-5xl">logout</span>
      </div>
      <h2 class="text-2xl font-bold mb-2">Konfirmasi Logout</h2>
      <p class="text-slate-400 mb-6">Apakah Anda yakin ingin keluar?</p>
      <div class="flex gap-3">
        <button onclick="closeLogoutModal()" class="flex-1 py-3 rounded-lg bg-white/5 hover:bg-white/10">Batal</button>
        <button onclick="doLogout()" class="flex-1 py-3 rounded-lg bg-red-500 hover:bg-red-600 text-white">Ya, Logout</button>
      </div>
    </div>
  </div>

  <script>
    var currentUser = null;

    function togglePassword() {
      const input = document.getElementById('login-pass');
      const icon = document.getElementById('toggle-icon');
      if (input.type === 'password') {
        input.type = 'text';
        icon.textContent = 'visibility_off';
      } else {
        input.type = 'password';
        icon.textContent = 'visibility';
      }
    }

    function handleLogin(e) {
  e.preventDefault();
  const id = document.getElementById('login-id').value.trim();
  const pass = document.getElementById('login-pass').value;
  
  google.script.run
    .withSuccessHandler(res => {
      if (res.success) {
        currentUser = res.user;
        document.getElementById('login-page').classList.add('hidden');
        document.getElementById('main-app').classList.remove('hidden');
        initApp();
      } else {
        let msg = '';
        if (res.message === 'user_not_found') {
          msg = 'Username atau Email tidak terdaftar dalam sistem';
        } else if (res.message === 'password_wrong') {
          msg = 'Password yang Anda masukkan salah';
        } else if (res.message === 'inactive') {
          msg = 'Akun Anda tidak aktif. Silakan hubungi administrator.';
        } else if (res.message === 'system_error') {
          msg = 'Terjadi kesalahan sistem: ' + (res.error || 'Silakan coba lagi');
        } else if (res.message === 'Database tidak ditemukan') {
          msg = 'Database tidak ditemukan. Pastikan sheet "PIC Setup" ada.';
        } else {
          msg = 'Terjadi kesalahan: ' + (res.message || 'Silakan coba lagi');
        }
        alert(msg);
      }
    })
    .withFailureHandler(error => {
      alert('Server error: ' + error.toString() + '\n\nPastikan Code.gs sudah di-save dan di-deploy ulang.');
    })
    .loginUser(id, pass);
}

    function initApp() {
      document.getElementById('header-name').textContent = currentUser.name;
      document.getElementById('header-role').textContent = currentUser.role;
      document.getElementById('header-avatar').textContent = currentUser.name.charAt(0).toUpperCase();
      
      google.script.run.withSuccessHandler(menus => {
        renderMenu(menus);
      }).getMenusByRole(currentUser.role);
    }

    function renderMenu(menus) {
      const nav = document.getElementById('sidebar-menu');
      nav.innerHTML = '<div class="px-4 mb-2 text-xs text-slate-500 uppercase sidebar-label">Main Menu</div>';
      
      if (menus.main) {
        menus.main.forEach((m, i) => {
          nav.innerHTML += '<div class="nav-item ' + (i===0?'active':'') + '" onclick="showPage(\'' + m.id + '\', this)">' +
            '<span class="material-symbols-outlined mr-3">' + (m.icon||'circle') + '</span>' +
            '<span class="sidebar-text">' + m.name + '</span></div>';
        });
      }
      
      if (menus.reporting && menus.reporting.length > 0) {
        nav.innerHTML += '<div class="px-4 mt-6 mb-2 text-xs text-slate-500 uppercase sidebar-label">Reporting</div>';
        menus.reporting.forEach(m => {
          nav.innerHTML += '<div class="nav-item" onclick="showPage(\'' + m.id + '\', this)">' +
            '<span class="material-symbols-outlined mr-3">' + (m.icon||'circle') + '</span>' +
            '<span class="sidebar-text">' + m.name + '</span></div>';
        });
      }
      
      if (currentUser.role === 'Superadmin' && menus.configuration) {
        nav.innerHTML += '<div class="px-4 mt-6 mb-2 text-xs text-slate-500 uppercase sidebar-label">Configuration</div>';
        menus.configuration.forEach(m => {
          nav.innerHTML += '<div class="nav-item" onclick="showPage(\'' + m.id + '\', this)">' +
            '<span class="material-symbols-outlined mr-3">' + (m.icon||'circle') + '</span>' +
            '<span class="sidebar-text">' + m.name + '</span></div>';
        });
      }
      
      showPage('dashboard', nav.querySelector('.nav-item'));
    }

    function showPage(pageId, el) {
      document.querySelectorAll('.page').forEach(p => p.classList.remove('active'));
      document.querySelectorAll('.nav-item').forEach(n => n.classList.remove('active'));
      var target = document.getElementById('page-' + pageId);
      if (target) target.classList.add('active');
      if (el) el.classList.add('active');
    }

    function toggleSidebar() {
      const sb = document.getElementById('sidebar');
      const header = document.getElementById('header');
      sb.classList.toggle('collapsed');
      header.style.left = sb.classList.contains('collapsed') ? '72px' : '260px';
    }

    function showLogoutModal() {
      document.getElementById('logout-modal').classList.add('active');
    }

    function closeLogoutModal() {
      document.getElementById('logout-modal').classList.remove('active');
    }

    function doLogout() {
      google.script.run.withSuccessHandler(() => {
        document.getElementById('logout-modal').classList.remove('active');
        document.getElementById('main-app').classList.add('hidden');
        document.getElementById('login-page').classList.remove('hidden');
        document.getElementById('login-id').value = '';
        document.getElementById('login-pass').value = '';
        currentUser = null;
      }).logoutUser();
    }
  </script>
</body>
</html>
