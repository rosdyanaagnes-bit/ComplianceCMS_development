<script>
var taskData = [];
var deleteTaskIndex = null;

window.initTaskPage = function() { loadTaskData(); };

function loadTaskData() {
  google.script.run.withSuccessHandler(function(res) {
    if (res && res.success) {
      taskData = res.tasks || [];
      renderTaskTable(taskData);
      updateTaskStats();
    }
  }).getTaskData();
}

function updateTaskStats() {
  document.getElementById('task-stat-total').textContent = taskData.length;
  document.getElementById('task-stat-progress').textContent = taskData.filter(function(t) { return t.StatusTask === 'In Progress'; }).length;
  document.getElementById('task-stat-completed').textContent = taskData.filter(function(t) { return t.StatusTask === 'Completed'; }).length;
  document.getElementById('task-stat-overdue').textContent = taskData.filter(function(t) { return t.DeadlineStatus === 'Overdue'; }).length;
}

function renderTaskTable(data) {
  var tbody = document.getElementById('task-table-body');
  if (!tbody) return;
  tbody.innerHTML = '';
  if (data.length === 0) {
    tbody.innerHTML = '<tr><td colspan="10" class="p-8 text-center text-slate-400">No tasks found</td></tr>';
    return;
  }
  data.forEach(function(task) {
    var priorityClass = task.Priority === 'High' ? 'bg-red-500/20 text-red-400' : task.Priority === 'Medium' ? 'bg-yellow-500/20 text-yellow-400' : 'bg-blue-500/20 text-blue-400';
    var statusClass = task.StatusTask === 'Completed' ? 'bg-green-500/20 text-green-400' : task.StatusTask === 'In Progress' ? 'bg-blue-500/20 text-blue-400' : task.StatusTask === 'On Hold' ? 'bg-orange-500/20 text-orange-400' : 'bg-slate-500/20 text-slate-400';
    var deadlineClass = task.DeadlineStatus === 'Overdue' ? 'text-red-400' : task.DeadlineStatus === 'Due Soon' ? 'text-yellow-400' : 'text-green-400';
    var progressColor = task.Progress >= 75 ? 'bg-green-500' : task.Progress >= 50 ? 'bg-yellow-500' : task.Progress >= 25 ? 'bg-blue-500' : 'bg-red-500';
    var row = document.createElement('tr');
    row.className = 'hover:bg-white/5 transition-colors';
    row.innerHTML = '<td class="p-4 text-sm text-slate-300 font-mono">' + (task.SubTaskID || '-') + '</td>' +
      '<td class="p-4 text-sm text-white font-medium truncate max-w-[200px]" title="' + (task.MainTask || '') + '">' + (task.MainTask || '-') + '</td>' +
      '<td class="p-4 text-sm text-slate-300 truncate max-w-[200px]" title="' + (task.DetailTask || '') + '">' + (task.DetailTask || '-') + '</td>' +
      '<td class="p-4 text-sm text-slate-300">' + (task.DelegationTo || '-') + '</td>' +
      '<td class="p-4"><span class="px-2 py-1 rounded text-xs font-semibold ' + priorityClass + '">' + (task.Priority || '-') + '</span></td>' +
      '<td class="p-4 text-sm text-slate-300 whitespace-nowrap">' + (task.DueDate || '-') + '</td>' +
      '<td class="p-4"><div class="flex items-center gap-2"><div class="w-16 h-2 bg-white/10 rounded-full overflow-hidden"><div class="' + progressColor + ' h-full rounded-full" style="width: ' + (task.Progress || 0) + '%"></div></div><span class="text-xs text-slate-400">' + (task.Progress || 0) + '%</span></div></td>' +
      '<td class="p-4"><span class="px-2 py-1 rounded text-xs font-semibold ' + statusClass + '">' + (task.StatusTask || '-') + '</span></td>' +
      '<td class="p-4 text-sm ' + deadlineClass + ' font-semibold whitespace-nowrap">' + (task.DeadlineStatus || '-') + '</td>' +
      '<td class="p-4 text-right"><div class="flex justify-end gap-1">' +
        '<button onclick="editTask(' + task.rowIndex + ')" class="p-2 text-[#9d4edd] hover:bg-[#9d4edd]/10 rounded-lg" title="Edit"><span class="material-symbols-outlined text-[18px]">edit</span></button>' +
      '</div></td>';
    tbody.appendChild(row);
  });
}

function filterTasks() {
  var search = document.getElementById('task-search').value.toLowerCase();
  var priorityFilter = document.getElementById('task-filter-priority').value;
  var statusFilter = document.getElementById('task-filter-status').value;
  var filtered = taskData.filter(function(task) {
    var matchSearch = !search || (task.MainTask && task.MainTask.toLowerCase().includes(search)) || (task.DetailTask && task.DetailTask.toLowerCase().includes(search)) || (task.DelegationTo && task.DelegationTo.toLowerCase().includes(search)) || (task.Category && task.Category.toLowerCase().includes(search));
    var matchPriority = !priorityFilter || task.Priority === priorityFilter;
    var matchStatus = !statusFilter || task.StatusTask === statusFilter;
    return matchSearch && matchPriority && matchStatus;
  });
  renderTaskTable(filtered);
}

function openTaskModal() {
  document.getElementById('task-modal-title').textContent = 'New Task';
  document.getElementById('task-form').reset();
  document.getElementById('task-row-index').value = '';
  document.getElementById('task-progress').value = '0';
  document.getElementById('btn-delete-task').classList.add('hidden');
  document.getElementById('task-modal').classList.remove('hidden');
}

function closeTaskModal() { document.getElementById('task-modal').classList.add('hidden'); }

function editTask(rowIndex) {
  var task = taskData.find(function(t) { return t.rowIndex === rowIndex; });
  if (!task) return;
  document.getElementById('task-modal-title').textContent = 'Edit Task';
  document.getElementById('task-row-index').value = task.rowIndex;
  document.getElementById('task-main').value = task.MainTask || '';
  document.getElementById('task-detail').value = task.DetailTask || '';
  document.getElementById('task-category').value = task.Category || '';
  document.getElementById('task-activity').value = task.ActivityType || '';
  document.getElementById('task-assigned-by').value = task.AssignedBy || '';
  document.getElementById('task-delegation').value = task.DelegationTo || '';
  document.getElementById('task-priority').value = task.Priority || 'Medium';
  document.getElementById('task-due-date').value = task.DueDate || '';
  document.getElementById('task-duration').value = task.TargetDuration || '';
  document.getElementById('task-business').value = task.BusinessModel || '';
  document.getElementById('task-status').value = task.StatusTask || 'Not Started';
  document.getElementById('task-progress').value = task.Progress || 0;
  document.getElementById('task-actual-finish').value = task.ActualFinish || '';
  document.getElementById('task-reviewer-notes').value = task.ReviewerNotes || '';
  document.getElementById('task-action-log').value = task.ActionLog || '';
  document.getElementById('task-reviewed-by').value = task.ReviewedBy || '';
  document.getElementById('task-approval-by').value = task.ApprovalBy || '';
  document.getElementById('btn-delete-task').classList.remove('hidden');
  document.getElementById('task-modal').classList.remove('hidden');
}

function saveTask(e) {
  e.preventDefault();
  if (typeof showLoading === 'function') showLoading('Saving task...');
  var rowIndex = document.getElementById('task-row-index').value;
  var payload = {
    MainTask: document.getElementById('task-main').value,
    DetailTask: document.getElementById('task-detail').value,
    Category: document.getElementById('task-category').value,
    ActivityType: document.getElementById('task-activity').value,
    AssignedBy: document.getElementById('task-assigned-by').value,
    DelegationTo: document.getElementById('task-delegation').value,
    Priority: document.getElementById('task-priority').value,
    DueDate: document.getElementById('task-due-date').value,
    TargetDuration: document.getElementById('task-duration').value,
    BusinessModel: document.getElementById('task-business').value,
    StatusTask: document.getElementById('task-status').value,
    Progress: parseInt(document.getElementById('task-progress').value) || 0,
    ActualFinish: document.getElementById('task-actual-finish').value,
    ReviewerNotes: document.getElementById('task-reviewer-notes').value,
    ActionLog: document.getElementById('task-action-log').value,
    ReviewedBy: document.getElementById('task-reviewed-by').value,
    ApprovalBy: document.getElementById('task-approval-by').value
  };
  google.script.run.withSuccessHandler(function(res) {
    if (typeof hideLoading === 'function') hideLoading();
    if (res && res.success) { closeTaskModal(); loadTaskData(); if (typeof showToast === 'function') showToast(res.message, 'success'); }
    else { if (typeof showToast === 'function') showToast(res.message || 'Failed', 'error'); }
  }).withFailureHandler(function(err) {
    if (typeof hideLoading === 'function') hideLoading();
    if (typeof showToast === 'function') showToast('Error: ' + err.toString(), 'error');
  }).saveTask(rowIndex, payload);
}

function deleteTaskFromModal() {
  var rowIndex = document.getElementById('task-row-index').value;
  if (!rowIndex) return;
  var task = taskData.find(function(t) { return t.rowIndex == rowIndex; });
  document.getElementById('delete-task-name').textContent = task ? (task.MainTask || '-') : '-';
  deleteTaskIndex = rowIndex;
  document.getElementById('task-modal').classList.add('hidden');
  document.getElementById('task-delete-modal').classList.remove('hidden');
}

function closeTaskDeleteModal() { document.getElementById('task-delete-modal').classList.add('hidden'); deleteTaskIndex = null; }

function confirmDeleteTask() {
  if (!deleteTaskIndex) return;
  if (typeof showLoading === 'function') showLoading('Deleting task...');
  document.getElementById('task-delete-modal').classList.add('hidden');
  google.script.run.withSuccessHandler(function(res) {
    if (typeof hideLoading === 'function') hideLoading();
    if (res && res.success) { loadTaskData(); if (typeof showToast === 'function') showToast('Task deleted', 'success'); }
    else { if (typeof showToast === 'function') showToast(res.message || 'Failed', 'error'); }
  }).withFailureHandler(function(err) {
    if (typeof hideLoading === 'function') hideLoading();
    if (typeof showToast === 'function') showToast('Error: ' + err.toString(), 'error');
  }).deleteTask(parseInt(deleteTaskIndex));
}
</script>
