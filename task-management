<script>
// ==========================================
// CONSTANTS (Skalabel - tambah di sini jika ada kategori baru)
// ==========================================
const ACTIVITY_TYPES = [
  "Regulatory Submission BI", "Regulatory Submission ASPI", "Regulatory Compliance",
  "Incidental Case", "Audit Finding", "Meeting & Coordination", "General Activity",
  "Compliance Communication", "Pelaporan (Insidental / Periodik)", "Unperiodic Program", "Regulatory Submission PPATK"
];
const CATEGORIES = [
  "📊 Reporting", "⚠️ Issue / Problem", "📑 Project / Initiative", "🎯 Objective Key Result (OKR)",
  "📚 Training & Awareness", "📝 Pelaporan (Insidental / Periodik)", "⚡ Unperiodic Program"
];

var taskData = [];
var currentView = 'board';
var currentDetailTaskId = null;
var pendingDeleteIndex = null;

window.initTaskPage = function() {
  populateDropdowns();
  loadTaskData();
};

function populateDropdowns() {
  document.getElementById('task-type').innerHTML = ACTIVITY_TYPES.map(t => `<option value="${t}">${t}</option>`).join('');
  document.getElementById('task-category').innerHTML = CATEGORIES.map(c => `<option value="${c}">${c}</option>`).join('');
  document.getElementById('filter-category').innerHTML = '<option value="">All Categories</option>' + CATEGORIES.map(c => `<option value="${c}">${c}</option>`).join('');
}

function loadTaskData() {
  google.script.run.withSuccessHandler(function(res) {
    if (res && res.success) {
      taskData = res.tasks || [];
      populateAssigneeFilter();
      populateReassignDropdown();
      renderTasks(taskData);
      updateStats();
    }
  }).getTaskData();
}

function populateAssigneeFilter() {
  var assignees = [...new Set(taskData.map(t => t.DelegationTo).filter(Boolean))].sort();
  document.getElementById('filter-assignee').innerHTML = '<option value="">All Assignees</option>' + assignees.map(a => `<option value="${a}">${a}</option>`).join('');
}

function populateReassignDropdown() {
  var users = [...new Set(taskData.map(t => t.DelegationTo).filter(Boolean))].sort();
  // Jika ada data user management, bisa digabung di sini
  document.getElementById('reassign-new').innerHTML = users.map(u => `<option value="${u}">${u}</option>`).join('');
}

function updateStats() {
  document.getElementById('stat-total').textContent = taskData.length;
  document.getElementById('stat-progress').textContent = taskData.filter(t => ['In Progress', 'Drafting', 'Internal Review', 'Evidence Collection', 'Investigation'].includes(t.StatusTask)).length;
  document.getElementById('stat-completed').textContent = taskData.filter(t => ['Completed', 'Closed'].includes(t.StatusTask)).length;
  document.getElementById('stat-overdue').textContent = taskData.filter(t => t.DeadlineStatus === 'Overdue').length;
}

function toggleTaskView(view) {
  currentView = view;
  document.getElementById('btn-view-board').className = view === 'board' ? 'px-3 py-1.5 rounded-md bg-[#00d4aa]/20 text-[#00d4aa] text-xs font-semibold transition flex items-center gap-1' : 'px-3 py-1.5 rounded-md text-slate-400 hover:text-white text-xs font-semibold transition flex items-center gap-1';
  document.getElementById('btn-view-list').className = view === 'list' ? 'px-3 py-1.5 rounded-md bg-[#00d4aa]/20 text-[#00d4aa] text-xs font-semibold transition flex items-center gap-1' : 'px-3 py-1.5 rounded-md text-slate-400 hover:text-white text-xs font-semibold transition flex items-center gap-1';
  var container = document.getElementById('task-container');
  container.className = view === 'board' ? 'grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 pb-8 transition-all duration-300' : 'grid grid-cols-1 gap-3 pb-8 transition-all duration-300';
  renderTasks(taskData);
}

function renderTasks(data) {
  var container = document.getElementById('task-container');
  container.innerHTML = '';
  if (data.length === 0) {
    container.innerHTML = '<div class="col-span-full text-center py-12 text-slate-500">No tasks found.</div>';
    return;
  }
  data.forEach(function(task) {
    var priorityColor = task.Priority === 'High' ? 'text-red-400 bg-red-500/10 border-red-500/30' : task.Priority === 'Medium' ? 'text-yellow-400 bg-yellow-500/10 border-yellow-500/30' : 'text-blue-400 bg-blue-500/10 border-blue-500/30';
    var deadlineColor = task.DeadlineStatus === 'Overdue' ? 'text-red-400' : task.DeadlineStatus === 'Due Soon' ? 'text-yellow-400' : 'text-green-400';
    var progressColor = task.Progress >= 75 ? 'bg-green-500' : task.Progress >= 50 ? 'bg-yellow-500' : task.Progress >= 25 ? 'bg-blue-500' : 'bg-red-500';
    var initial = (task.DelegationTo || 'U').charAt(0).toUpperCase();
    var statusColor = ['Completed', 'Closed'].includes(task.StatusTask) ? 'bg-green-500/20 text-green-400' : ['Submitted', 'Waiting Response', 'Re-submitted', 'Delivered', 'MoM Sent', 'Ready to Submit', 'Ready to Deliver', 'Waiting Approval'].includes(task.StatusTask) ? 'bg-blue-500/20 text-blue-400' : ['Revision Required', 'On Hold', 'Cancelled'].includes(task.StatusTask) ? 'bg-orange-500/20 text-orange-400' : 'bg-white/10 text-slate-300';

    var card = document.createElement('div');
    card.className = currentView === 'board'
      ? 'glass rounded-lg p-4 hover:shadow-lg hover:-translate-y-1 transition-all duration-300 border border-white/5 flex flex-col h-full cursor-pointer'
      : 'glass rounded-lg p-3 hover:bg-white/5 transition-all border border-white/5 flex items-center gap-4 cursor-pointer';
    card.onclick = function(e) {
      // Cegah klik pada button memicu open detail
      if (e.target.closest('button') || e.target.closest('a')) return;
      openTaskDetail(task.rowIndex);
    };

    if (currentView === 'board') {
      card.innerHTML = `
        <div class="flex justify-between items-start mb-2">
          <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold bg-[#00d4aa]/20 text-[#00d4aa] border border-[#00d4aa]/30 truncate max-w-[60%]">${task.Category || ''}</span>
          <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold border ${priorityColor}">${task.Priority || 'Medium'}</span>
        </div>
        <h3 class="text-sm font-bold text-white mb-1 line-clamp-2 leading-tight">${task.MainTask || 'Untitled'}</h3>
        <p class="text-[11px] text-slate-400 mb-3 line-clamp-2 flex-grow">${task.DetailTask || ''}</p>
        <div class="flex items-center gap-2 mb-3">
          <div class="w-5 h-5 rounded-full bg-gradient-to-br from-[#9d4edd] to-[#00d4aa] flex items-center justify-center text-[10px] text-white font-bold">${initial}</div>
          <span class="text-[11px] text-white truncate">${task.DelegationTo || 'Unassigned'}</span>
        </div>
        <div class="mt-auto pt-3 border-t border-white/10 flex justify-between items-center text-[10px]">
          <span class="text-slate-400">Due: ${task.DueDate || '-'}</span>
          <span class="${deadlineColor} font-semibold">${task.DeadlineStatus || 'On Track'}</span>
        </div>
        <div class="w-full h-1.5 bg-white/10 rounded-full overflow-hidden mt-2">
          <div class="${progressColor} h-full rounded-full" style="width: ${task.Progress || 0}%"></div>
        </div>
        <div class="flex gap-2 mt-3">
          <button onclick="event.stopPropagation(); editTask(${task.rowIndex})" class="flex-1 py-1.5 rounded bg-white/5 hover:bg-white/10 text-[10px] text-white transition flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-[12px]">edit</span> Edit
          </button>
          <button onclick="event.stopPropagation(); openTaskDetail(${task.rowIndex})" class="flex-1 py-1.5 rounded bg-[#00d4aa]/10 hover:bg-[#00d4aa]/20 text-[10px] text-[#00d4aa] transition flex items-center justify-center gap-1">
            <span class="material-symbols-outlined text-[12px]">visibility</span> Detail
          </button>
        </div>
      `;
    } else {
      card.innerHTML = `
        <div class="w-8 h-8 rounded-full bg-gradient-to-br from-[#9d4edd] to-[#00d4aa] flex items-center justify-center text-xs text-white font-bold flex-shrink-0">${initial}</div>
        <div class="flex-grow min-w-0">
          <div class="flex items-center gap-2 mb-0.5">
            <span class="text-[10px] font-mono text-slate-500">${task.SubTaskID || ''}</span>
            <h3 class="text-sm font-bold text-white truncate">${task.MainTask || 'Untitled'}</h3>
            <span class="px-1.5 py-0.5 rounded text-[10px] font-semibold border ${priorityColor} flex-shrink-0">${task.Priority}</span>
          </div>
          <div class="flex items-center gap-3 text-[11px] text-slate-400">
            <span>${task.DelegationTo || '-'}</span>
            <span>•</span>
            <span>${task.Category || '-'}</span>
            <span>•</span>
            <span class="${deadlineColor}">Due: ${task.DueDate || '-'}</span>
          </div>
        </div>
        <div class="flex items-center gap-4 flex-shrink-0">
          <div class="w-24">
            <div class="flex justify-between text-[10px] mb-1"><span class="text-slate-500">Progress</span><span class="text-white">${task.Progress || 0}%</span></div>
            <div class="w-full h-1.5 bg-white/10 rounded-full overflow-hidden"><div class="${progressColor} h-full rounded-full" style="width: ${task.Progress || 0}%"></div></div>
          </div>
          <span class="px-2 py-1 rounded text-[10px] font-semibold ${statusColor} whitespace-nowrap">${task.StatusTask || 'Not Started'}</span>
          <button onclick="event.stopPropagation(); editTask(${task.rowIndex})" class="p-1.5 rounded hover:bg-white/10 text-slate-400 hover:text-white"><span class="material-symbols-outlined text-[16px]">edit</span></button>
        </div>
      `;
    }
    container.appendChild(card);
  });
}

function filterTasks() {
  var search = document.getElementById('task-search').value.toLowerCase();
  var assignee = document.getElementById('filter-assignee').value;
  var category = document.getElementById('filter-category').value;
  var month = document.getElementById('filter-date').value;
  var filtered = taskData.filter(function(task) {
    var matchSearch = !search || (task.MainTask && task.MainTask.toLowerCase().includes(search)) || (task.DelegationTo && task.DelegationTo.toLowerCase().includes(search)) || (task.SubTaskID && task.SubTaskID.toLowerCase().includes(search));
    var matchAssignee = !assignee || task.DelegationTo === assignee;
    var matchCategory = !category || task.Category === category;
    var matchMonth = !month || (task.DueDate && task.DueDate.startsWith(month));
    return matchSearch && matchAssignee && matchCategory && matchMonth;
  });
  renderTasks(filtered);
}

// ==========================================
// DETAIL VIEW
// ==========================================
function openTaskDetail(rowIndex) {
  var task = taskData.find(t => t.rowIndex === rowIndex);
  if (!task) return;
  currentDetailTaskId = rowIndex;
  document.getElementById('detail-task-id').textContent = task.SubTaskID || 'No ID';
  document.getElementById('detail-task-type').textContent = task.ActivityType || 'General';
  document.getElementById('detail-task-title').textContent = task.MainTask;
  document.getElementById('detail-task-desc').textContent = task.DetailTask;
  document.getElementById('detail-assignee').textContent = task.DelegationTo || '-';
  document.getElementById('detail-due').textContent = task.DueDate || '-';
  document.getElementById('detail-priority').textContent = task.Priority || '-';
  document.getElementById('detail-status').textContent = task.StatusTask || '-';
  document.getElementById('detail-link').textContent = task.DriveLink || 'No link attached';
  document.getElementById('detail-link').href = task.DriveLink || '#';
  document.getElementById('detail-progress-val').textContent = task.Progress || 0;
  document.getElementById('detail-progress-bar').style.width = (task.Progress || 0) + '%';
  document.getElementById('detail-category').textContent = task.Category || '-';
  document.getElementById('detail-assigned-by').textContent = task.AssignedBy || '-';
  document.getElementById('detail-finish').textContent = task.ActualFinish || '-';
  document.getElementById('detail-updated').textContent = (task.LastUpdate || '') + ' by ' + (task.LastUpdatedBy || '-');
  renderNotesTimeline(task.NotesLog || []);
  document.getElementById('task-detail-view').classList.remove('hidden');
}

function closeTaskDetail() {
  document.getElementById('task-detail-view').classList.add('hidden');
  currentDetailTaskId = null;
}

function renderNotesTimeline(notes) {
  var container = document.getElementById('notes-timeline');
  container.innerHTML = '';
  if (!notes || notes.length === 0) {
    container.innerHTML = '<p class="text-slate-500 text-sm italic">No notes or action logs yet.</p>';
    return;
  }
  notes.sort((a, b) => new Date(b.timestamp) - new Date(a.timestamp));
  notes.forEach(note => {
    var date = new Date(note.timestamp);
    var dateStr = date.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
    var timeStr = date.toLocaleTimeString('en-US', { hour: '2-digit', minute: '2-digit' });
    var item = document.createElement('div');
    item.className = 'relative mb-6';
    item.innerHTML = `
      <div class="absolute -left-[31px] top-1 w-4 h-4 rounded-full bg-[#00d4aa] border-4 border-[#0f172a]"></div>
      <div class="glass p-3 rounded-lg border border-white/10">
        <div class="flex justify-between items-start mb-1">
          <span class="text-xs font-bold text-white">${note.author || 'System'}</span>
          <div class="flex gap-1">
            <button onclick="editNote(${note.id})" class="text-slate-500 hover:text-[#00d4aa] transition"><span class="material-symbols-outlined text-[14px]">edit</span></button>
            <button onclick="deleteNote(${note.id})" class="text-slate-500 hover:text-red-400 transition"><span class="material-symbols-outlined text-[14px]">delete</span></button>
          </div>
        </div>
        <p class="text-sm text-slate-300 whitespace-pre-line mb-2">${note.text}</p>
        <div class="text-[10px] text-slate-500 flex gap-2">
          <span>Created: ${dateStr} ${timeStr}</span>
          ${note.updatedAt ? `<span>• Updated: ${new Date(note.updatedAt).toLocaleDateString()} ${new Date(note.updatedAt).toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'})}</span>` : ''}
        </div>
      </div>
    `;
    container.appendChild(item);
  });
}

function editTaskFromDetail() {
  var rowIndex = currentDetailTaskId;
  closeTaskDetail();
  setTimeout(() => editTask(rowIndex), 100);
}

// ==========================================
// REASSIGN LOGIC
// ==========================================
function openReassignModal() {
  var task = taskData.find(t => t.rowIndex === currentDetailTaskId);
  if (!task) return;
  document.getElementById('reassign-current').value = task.DelegationTo || '-';
  populateReassignDropdown();
  document.getElementById('reassign-new').value = '';
  document.getElementById('reassign-reason').value = '';
  document.getElementById('reassign-modal').classList.remove('hidden');
}
function closeReassignModal() { document.getElementById('reassign-modal').classList.add('hidden'); }

function confirmReassign() {
  var newAssignee = document.getElementById('reassign-new').value;
  var reason = document.getElementById('reassign-reason').value;
  if (!newAssignee) { alert('Please select new assignee'); return; }
  if (typeof showLoading === 'function') showLoading('Reassigning task...');
  closeReassignModal();
  google.script.run.withSuccessHandler(function(res) {
    if (typeof hideLoading === 'function') hideLoading();
    if (res && res.success) {
      loadTaskData();
      setTimeout(() => openTaskDetail(currentDetailTaskId), 500);
      if (typeof showToast === 'function') showToast('Task reassigned successfully', 'success');
    }
  }).reassignTask(currentDetailTaskId, newAssignee, reason);
}

// ==========================================
// NOTES LOGIC
// ==========================================
function openAddNoteModal() {
  document.getElementById('note-modal-title').textContent = 'Add Note';
  document.getElementById('note-text').value = '';
  document.getElementById('note-edit-id').value = '';
  document.getElementById('note-modal').classList.remove('hidden');
}
function closeNoteModal() { document.getElementById('note-modal').classList.add('hidden'); }

function editNote(noteId) {
  var task = taskData.find(t => t.rowIndex === currentDetailTaskId);
  var notes = task.NotesLog || [];
  var note = notes.find(n => n.id === noteId);
  if (note) {
    document.getElementById('note-modal-title').textContent = 'Edit Note';
    document.getElementById('note-text').value = note.text;
    document.getElementById('note-edit-id').value = noteId;
    document.getElementById('note-modal').classList.remove('hidden');
  }
}

function deleteNote(noteId) {
  if (!confirm('Delete this note?')) return;
  var task = taskData.find(t => t.rowIndex === currentDetailTaskId);
  var notes = (task.NotesLog || []).filter(n => n.id !== noteId);
  if (typeof showLoading === 'function') showLoading('Updating notes...');
  google.script.run.withSuccessHandler(function(res) {
    if (typeof hideLoading === 'function') hideLoading();
    if (res && res.success) {
      loadTaskData();
      setTimeout(() => openTaskDetail(currentDetailTaskId), 500);
    }
  }).updateTaskNotes(currentDetailTaskId, JSON.stringify(notes));
}

function saveNote() {
  var text = document.getElementById('note-text').value.trim();
  if (!text) return;
  var editId = document.getElementById('note-edit-id').value;
  var task = taskData.find(t => t.rowIndex === currentDetailTaskId);
  var notes = task.NotesLog || [];
  var currentUser = (typeof currentUser !== 'undefined' && currentUser) ? currentUser.name : 'System';
  if (editId) {
    var note = notes.find(n => n.id == editId);
    if (note) { note.text = text; note.updatedAt = new Date().toISOString(); }
  } else {
    notes.push({ id: Date.now(), timestamp: new Date().toISOString(), author: currentUser, text: text });
  }
  if (typeof showLoading === 'function') showLoading('Saving note...');
  google.script.run.withSuccessHandler(function(res) {
    if (typeof hideLoading === 'function') hideLoading();
    if (res && res.success) {
      closeNoteModal();
      loadTaskData();
      setTimeout(() => openTaskDetail(currentDetailTaskId), 500);
    } else {
      if (typeof showToast === 'function') showToast(res.message || 'Failed', 'error');
    }
  }).withFailureHandler(function(err) {
    if (typeof hideLoading === 'function') hideLoading();
    if (typeof showToast === 'function') showToast('Error: ' + err.toString(), 'error');
  }).updateTaskNotes(currentDetailTaskId, JSON.stringify(notes));
}

// ==========================================
// CRUD TASK
// ==========================================
function openTaskModal() {
  document.getElementById('task-modal-title').textContent = 'New Task';
  document.getElementById('task-form').reset();
  document.getElementById('task-row-index').value = '';
  document.getElementById('task-progress').value = '0';
  document.getElementById('btn-delete-task').classList.add('hidden');
  document.getElementById('task-modal').classList.remove('hidden');
}
function closeTaskModal() { document.getElementById('task-modal').classList.add('hidden'); }

function editTask(rowIndex) {
  var task = taskData.find(t => t.rowIndex === rowIndex);
  if (!task) return;
  document.getElementById('task-modal-title').textContent = 'Edit Task';
  document.getElementById('task-row-index').value = task.rowIndex;
  document.getElementById('task-main').value = task.MainTask || '';
  document.getElementById('task-detail').value = task.DetailTask || '';
  document.getElementById('task-type').value = task.ActivityType || 'General Activity';
  document.getElementById('task-category').value = task.Category || '📊 Reporting';
  document.getElementById('task-assigned-by').value = task.AssignedBy || '';
  document.getElementById('task-delegation').value = task.DelegationTo || '';
  document.getElementById('task-due-date').value = task.DueDate || '';
  document.getElementById('task-priority').value = task.Priority || 'Medium';
  document.getElementById('task-status').value = task.StatusTask || 'Not Started';
  document.getElementById('task-progress').value = task.Progress || 0;
  document.getElementById('task-doc-link').value = task.DriveLink || '';
  document.getElementById('btn-delete-task').classList.remove('hidden');
  document.getElementById('task-modal').classList.remove('hidden');
}

function saveTask(e) {
  e.preventDefault();
  if (typeof showLoading === 'function') showLoading('Saving task...');
  var rowIndex = document.getElementById('task-row-index').value;
  var payload = {
    MainTask: document.getElementById('task-main').value,
    DetailTask: document.getElementById('task-detail').value,
    ActivityType: document.getElementById('task-type').value,
    Category: document.getElementById('task-category').value,
    AssignedBy: document.getElementById('task-assigned-by').value,
    DelegationTo: document.getElementById('task-delegation').value,
    DueDate: document.getElementById('task-due-date').value,
    Priority: document.getElementById('task-priority').value,
    StatusTask: document.getElementById('task-status').value,
    Progress: parseInt(document.getElementById('task-progress').value) || 0,
    DriveLink: document.getElementById('task-doc-link').value
  };
  google.script.run.withSuccessHandler(function(res) {
    if (typeof hideLoading === 'function') hideLoading();
    if (res && res.success) { closeTaskModal(); loadTaskData(); if (typeof showToast === 'function') showToast(res.message, 'success'); }
    else { if (typeof showToast === 'function') showToast(res.message || 'Failed', 'error'); }
  }).withFailureHandler(function(err) {
    if (typeof hideLoading === 'function') hideLoading();
    if (typeof showToast === 'function') showToast('Error: ' + err.toString(), 'error');
  }).saveTask(rowIndex, payload);
}

function showDeleteConfirm() {
  var rowIndex = document.getElementById('task-row-index').value;
  if (!rowIndex) return;
  var task = taskData.find(t => t.rowIndex == rowIndex);
  document.getElementById('delete-task-name').textContent = task ? (task.MainTask || '-') : '-';
  pendingDeleteIndex = rowIndex;
  document.getElementById('task-modal').classList.add('hidden');
  document.getElementById('task-delete-modal').classList.remove('hidden');
}
function closeTaskDeleteModal() { document.getElementById('task-delete-modal').classList.add('hidden'); pendingDeleteIndex = null; }

function confirmDeleteTask() {
  if (!pendingDeleteIndex) return;
  if (typeof showLoading === 'function') showLoading('Deleting task...');
  document.getElementById('task-delete-modal').classList.add('hidden');
  google.script.run.withSuccessHandler(function(res) {
    if (typeof hideLoading === 'function') hideLoading();
    if (res && res.success) { loadTaskData(); if (typeof showToast === 'function') showToast('Task deleted', 'success'); }
    else { if (typeof showToast === 'function') showToast(res.message || 'Failed', 'error'); }
  }).withFailureHandler(function(err) {
    if (typeof hideLoading === 'function') hideLoading();
    if (typeof showToast === 'function') showToast('Error: ' + err.toString(), 'error');
  }).deleteTask(parseInt(pendingDeleteIndex));
}
</script>
