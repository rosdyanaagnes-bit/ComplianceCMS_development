<div id="page-config-users" class="page">
  <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-8">
    <div>
      <div class="flex items-center gap-2 text-[#00d4aa] font-semibold text-sm uppercase tracking-widest">
        <span class="w-8 h-[2px] bg-[#00d4aa]"></span>Configuration
      </div>
      <h1 class="text-3xl font-bold text-white">User Management</h1>
      <p class="text-slate-400 text-sm mt-1">Kelola pengguna sistem Compliance Activity</p>
    </div>
    <div class="flex gap-3">
      <button onclick="openCreateUserModal()" class="flex items-center gap-2 px-6 py-2.5 bg-gradient-to-r from-[#00d4aa] to-[#9d4edd] text-white font-semibold rounded-full hover:opacity-90 shadow-[0_0_15px_rgba(0,212,170,0.3)] transition">
        <span class="material-symbols-outlined">person_add</span>Add User
      </button>
    </div>
  </div>

  <!-- ✅ REVISI 4: Total Roles dihapus, grid menjadi 3 kolom -->
  <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-6">
    <div class="glass p-6 rounded-2xl">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-[#00d4aa]/20 rounded-xl flex items-center justify-center">
          <span class="material-symbols-outlined text-[#00d4aa]">group</span>
        </div>
        <div>
          <div class="text-slate-400 text-xs uppercase">Total Users</div>
          <div class="text-2xl font-bold text-white" id="stat-total">0</div>
        </div>
      </div>
    </div>
    <div class="glass p-6 rounded-2xl">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center">
          <span class="material-symbols-outlined text-green-400">check_circle</span>
        </div>
        <div>
          <div class="text-slate-400 text-xs uppercase">Active Users</div>
          <div class="text-2xl font-bold text-green-400" id="stat-active">0</div>
        </div>
      </div>
    </div>
    <div class="glass p-6 rounded-2xl">
      <div class="flex items-center gap-4">
        <div class="w-12 h-12 bg-red-500/20 rounded-xl flex items-center justify-center">
          <span class="material-symbols-outlined text-red-400">cancel</span>
        </div>
        <div>
          <div class="text-slate-400 text-xs uppercase">Inactive Users</div>
          <div class="text-2xl font-bold text-red-400" id="stat-inactive">0</div>
        </div>
      </div>
    </div>
  </div>

  <div class="glass p-6 rounded-2xl mb-6">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <div class="md:col-span-2">
        <label class="text-xs text-slate-400 ml-1">Search User</label>
        <div class="relative">
          <span class="material-symbols-outlined absolute left-3 top-1/2 -translate-y-1/2 text-slate-500 text-[20px]">search</span>
          <input id="searchUser" onkeyup="filterUsers()" class="w-full pl-10 pr-4 py-2.5 bg-black/20 border border-white/10 rounded-lg text-sm text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa] placeholder-slate-500" placeholder="Cari nama, username, atau email..." type="text">
        </div>
      </div>
      <div>
        <label class="text-xs text-slate-400 ml-1">Role</label>
        <select id="filterRole" onchange="filterUsers()" class="w-full px-4 py-2.5 bg-black/20 border border-white/10 rounded-lg text-sm text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa]">
          <option value="">All Roles</option>
        </select>
      </div>
      <div>
        <label class="text-xs text-slate-400 ml-1">Status</label>
        <select id="filterStatus" onchange="filterUsers()" class="w-full px-4 py-2.5 bg-black/20 border border-white/10 rounded-lg text-sm text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa]">
          <option value="">All Status</option>
          <option value="Aktif">Aktif</option>
          <option value="Nonaktif">Nonaktif</option>
        </select>
      </div>
    </div>
  </div>

  <div class="glass rounded-2xl overflow-hidden">
    <div class="overflow-x-auto">
      <table class="w-full">
        <thead class="bg-black/20">
          <tr>
            <th class="p-4 text-left text-slate-400 text-xs uppercase font-semibold">User</th>
            <th class="p-4 text-left text-slate-400 text-xs uppercase font-semibold">Username</th>
            <th class="p-4 text-left text-slate-400 text-xs uppercase font-semibold">Role</th>
            <th class="p-4 text-left text-slate-400 text-xs uppercase font-semibold">Status</th>
            <th class="p-4 text-left text-slate-400 text-xs uppercase font-semibold">Date Created</th>
            <th class="p-4 text-right text-slate-400 text-xs uppercase font-semibold">Actions</th>
          </tr>
        </thead>
        <tbody id="user-table-body" class="divide-y divide-white/5">
          <tr><td colspan="6" class="p-8 text-center text-slate-400">Loading users...</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<!-- CREATE/EDIT USER MODAL -->
<div id="user-modal" class="fixed inset-0 z-[10000] hidden items-center justify-center" style="background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(8px);">
  <div class="glass rounded-2xl shadow-2xl max-w-2xl w-full mx-4 border border-white/10" style="animation: fadeIn 0.3s ease-out;">
    <div class="border-b border-white/10 p-6 flex justify-between items-center">
      <h2 class="text-2xl font-bold text-white" id="user-modal-title">Add New User</h2>
      <button onclick="closeUserModal()" class="p-2 hover:bg-white/10 rounded-lg transition">
        <span class="material-symbols-outlined text-slate-400">close</span>
      </button>
    </div>
    <form id="user-form" onsubmit="saveUser(event)" class="p-6">
      <input type="hidden" id="user-row-index">
      <div class="grid grid-cols-2 gap-4">
        <div class="col-span-2">
          <label class="block text-sm font-semibold text-slate-300 mb-2">Nama Lengkap *</label>
          <input type="text" id="user-name" required class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa] placeholder-slate-500" placeholder="Nama lengkap pengguna">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-300 mb-2">Username *</label>
          <input type="text" id="user-username" required class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa] placeholder-slate-500" placeholder="Username unik">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-300 mb-2">Email *</label>
          <input type="email" id="user-email" required class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa] placeholder-slate-500" placeholder="nama@company.com">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-300 mb-2">No. Telepon/WhatsApp</label>
          <input type="tel" id="user-phone" class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa] placeholder-slate-500" placeholder="contoh : 08121260XXXX">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-300 mb-2">Telegram ID (Optional)</label>
          <input type="text" id="user-telegram" class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa] placeholder-slate-500" placeholder="contoh : 28046770">
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-300 mb-2">Role *</label>
          <select id="user-role" required class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa]">
            <option value="">Pilih Role...</option>
          </select>
        </div>
        <div>
          <label class="block text-sm font-semibold text-slate-300 mb-2">Status *</label>
          <select id="user-status" required class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa]">
            <option value="Aktif">Aktif</option>
            <option value="Nonaktif">Nonaktif</option>
          </select>
        </div>
        <div class="col-span-2 bg-[#00d4aa]/10 p-4 rounded-lg border border-[#00d4aa]/20">
          <div class="flex items-start gap-3">
            <span class="material-symbols-outlined text-[#00d4aa] mt-0.5">key</span>
            <div class="flex-1">
              <p class="text-sm font-semibold text-[#00d4aa]">Password Management</p>
              <p class="text-xs text-slate-400 mt-1">Password akan di-generate otomatis saat membuat user baru.</p>
              <div class="mt-3 flex gap-2">
                <input type="text" id="user-display-password" readonly class="flex-1 px-3 py-2 bg-black/30 border border-white/10 rounded text-sm text-slate-300 font-mono" placeholder="Password akan muncul di sini">
                <button type="button" onclick="generateAndShowPassword()" class="px-4 py-2 bg-[#9d4edd] text-white text-sm font-semibold rounded hover:bg-[#9d4edd]/80 transition">Generate</button>
              </div>
            </div>
          </div>
        </div>
      </div>
      <div class="mt-6 flex gap-3">
        <button type="button" onclick="closeUserModal()" class="flex-1 py-3 rounded-lg font-semibold text-slate-300 bg-white/5 hover:bg-white/10 border border-white/10 transition">Cancel</button>
        <button type="submit" class="flex-1 py-3 rounded-lg font-semibold text-white bg-gradient-to-r from-[#00d4aa] to-[#9d4edd] hover:opacity-90 transition shadow-[0_0_15px_rgba(0,212,170,0.3)]">Save User</button>
      </div>
    </form>
  </div>
</div>

<!-- ✅ REVISI 2: Pop up Reset Password dengan UI yang Bagus -->
<div id="reset-password-modal" class="fixed inset-0 z-[10000] hidden items-center justify-center" style="background: rgba(0, 0, 0, 0.7); backdrop-filter: blur(8px);">
  <div class="glass rounded-2xl shadow-2xl max-w-md w-full mx-4 p-8 text-center border border-white/10" style="animation: fadeIn 0.3s ease-out;">
    <div class="w-20 h-20 bg-gradient-to-br from-[#00d4aa] to-[#9d4edd] rounded-full flex items-center justify-center mx-auto mb-4 shadow-[0_0_30px_rgba(0,212,170,0.3)]">
      <span class="material-symbols-outlined text-white" style="font-size: 48px;">lock_reset</span>
    </div>
    <h2 class="text-2xl font-bold text-white mb-2">Reset Password?</h2>
    <p class="text-slate-400 mb-4">Password baru akan di-generate dan dikirim ke email:</p>
    <div class="bg-white/5 rounded-lg p-4 mb-6 border border-white/10 flex items-center gap-3 justify-center">
      <span class="material-symbols-outlined text-[#00d4aa]">email</span>
      <span class="font-semibold text-white" id="reset-password-email-display">-</span>
    </div>
    <div class="flex gap-3">
      <button onclick="closeResetPasswordModal()" class="flex-1 py-3 rounded-lg font-semibold text-slate-300 bg-white/5 hover:bg-white/10 border border-white/10 transition">Batal</button>
      <button onclick="confirmResetPassword()" class="flex-1 py-3 rounded-lg font-semibold text-white bg-gradient-to-r from-[#00d4aa] to-[#9d4edd] hover:opacity-90 transition shadow-[0_0_15px_rgba(0,212,170,0.3)]">Ya, Reset & Kirim</button>
    </div>
  </div>
</div>

<script>
  var allUsers = [];
  var filteredUsers = [];
  var allRoles = [];
  var resetPasswordRowIndex = null; // ✅ Hanya simpan index untuk reset password
  var tempPassword = '';

  // ✅ REVISI 1 & 5: Load data langsung tanpa loading page full screen, data selalu fresh dari sheet
  function loadUsers() {
    console.log('=== loadUsers START (Fresh from Sheet) ===');
    
    google.script.run
      .withSuccessHandler(function(res) {
        if (res && res.success) {
          allUsers = res.users || [];
          console.log('Total users loaded:', allUsers.length);
          filteredUsers = [...allUsers];
          renderUsers();
          updateUserStats();
          loadRolesAsync();
        }
      })
      .withFailureHandler(function(err) {
        console.error('=== getAllUsers FAILURE ===', err);
      })
      .getAllUsers();
  }

  function loadRolesAsync() {
    google.script.run
      .withSuccessHandler(function(res) {
        if (res && res.success) {
          allRoles = res.roles || [];
          populateRoleDropdown();
        }
      })
      .getAllRoles();
  }

  function populateRoleDropdown() {
    var select = document.getElementById('user-role');
    var filterSelect = document.getElementById('filterRole');
    if (!select) return;
    
    var currentValue = select.value;
    select.innerHTML = '<option value="">Pilih Role...</option>';
    if (filterSelect) filterSelect.innerHTML = '<option value="">All Roles</option>';
    
    allRoles.forEach(function(role) {
      if (role.Status === 'Aktif') {
        select.innerHTML += '<option value="' + role['Nama Role'] + '">' + role['Nama Role'] + '</option>';
        if (filterSelect) filterSelect.innerHTML += '<option value="' + role['Nama Role'] + '">' + role['Nama Role'] + '</option>';
      }
    });
    if (currentValue) select.value = currentValue;
  }

  function renderUsers() {
    var tbody = document.getElementById('user-table-body');
    if (!tbody) return;
    tbody.innerHTML = '';
    
    if (filteredUsers.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" class="p-8 text-center text-slate-400">Tidak ada user ditemukan</td></tr>';
      return;
    }
    
    filteredUsers.forEach(function(user) {
      var statusClass = user.Status === 'Aktif' ? 'bg-green-500/20 text-green-400 border-green-500/30' : 'bg-red-500/20 text-red-400 border-red-500/30';
      var initial = (user['Nama Lengkap'] || 'U').charAt(0).toUpperCase();
      
      var photoHtml = user['Foto Profil'] 
        ? '<img src="' + user['Foto Profil'] + '" class="w-10 h-10 rounded-full object-cover border-2 border-[#00d4aa]/50">'
        : '<div class="w-10 h-10 rounded-full bg-gradient-to-br from-[#00d4aa] to-[#9d4edd] flex items-center justify-center text-white font-bold shadow-lg">' + initial + '</div>';
      
      var roleBadge = user.Role 
        ? '<span class="px-2 py-1 bg-white/10 text-white border border-white/20 rounded text-xs font-semibold">' + user.Role + '</span>'
        : '<span class="px-2 py-1 bg-white/5 text-slate-400 border border-white/10 rounded text-xs">-</span>';
      
      var rowIndex = user.rowIndex;
      
      // ✅ REVISI: Tombol Delete dihapus, hanya tersisa Reset Password dan Edit
      var row = document.createElement('tr');
      row.className = 'hover:bg-white/5 transition-colors';
      row.innerHTML = '<td class="p-4"><div class="flex items-center gap-3">' + photoHtml + '<div><div class="font-semibold text-white">' + (user['Nama Lengkap'] || '-') + '</div><div class="text-xs text-slate-400">' + (user.Email || '-') + '</div></div></div></td>' +
        '<td class="p-4 font-mono text-sm text-slate-300">' + (user.Username || '-') + '</td>' +
        '<td class="p-4">' + roleBadge + '</td>' +
        '<td class="p-4"><span class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-semibold border ' + statusClass + '">' + (user.Status || '-') + '</span></td>' +
        '<td class="p-4 text-sm text-slate-400">' + (user['Date Created'] || '-') + '</td>' +
        '<td class="p-4 text-right"><div class="flex justify-end gap-1">' +
          '<button onclick="openResetPasswordModal(' + rowIndex + ')" class="p-2 text-[#00d4aa] hover:bg-[#00d4aa]/10 rounded-lg transition group" title="Reset Password">' +
            '<span class="material-symbols-outlined text-[18px] group-hover:scale-110 transition-transform">key</span>' +
          '</button>' +
          '<button onclick="editUser(' + rowIndex + ')" class="p-2 text-blue-400 hover:bg-blue-500/10 rounded-lg transition group" title="Edit">' +
            '<span class="material-symbols-outlined text-[18px] group-hover:scale-110 transition-transform">edit</span>' +
          '</button>' +
        '</div></td>';
      tbody.appendChild(row);
    });
  }

  function updateUserStats() {
    var totalEl = document.getElementById('stat-total');
    var activeEl = document.getElementById('stat-active');
    var inactiveEl = document.getElementById('stat-inactive');
    if (totalEl) totalEl.textContent = allUsers.length;
    if (activeEl) activeEl.textContent = allUsers.filter(function(u) { return u.Status === 'Aktif'; }).length;
    if (inactiveEl) inactiveEl.textContent = allUsers.filter(function(u) { return u.Status === 'Nonaktif'; }).length;
  }

  function filterUsers() {
    var search = document.getElementById('searchUser').value.toLowerCase();
    var roleFilter = document.getElementById('filterRole').value;
    var statusFilter = document.getElementById('filterStatus').value;
    
    filteredUsers = allUsers.filter(function(user) {
      var name = (user['Nama Lengkap'] || '').toString().toLowerCase();
      var username = (user.Username || '').toString().toLowerCase();
      var email = (user.Email || '').toString().toLowerCase();
      var matchSearch = !search || name.includes(search) || username.includes(search) || email.includes(search);
      var matchRole = !roleFilter || user.Role === roleFilter;
      var matchStatus = !statusFilter || user.Status === statusFilter;
      return matchSearch && matchRole && matchStatus;
    });
    renderUsers();
  }

  function openCreateUserModal() {
    document.getElementById('user-modal-title').textContent = 'Add New User';
    document.getElementById('user-form').reset();
    document.getElementById('user-row-index').value = '';
    document.getElementById('user-display-password').value = '';
    tempPassword = generatePasswordClient(10);
    document.getElementById('user-display-password').value = tempPassword;
    document.getElementById('user-modal').classList.remove('hidden');
    document.getElementById('user-modal').classList.add('flex');
  }

  function generatePasswordClient(length) {
    var chars = 'ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789!@#$';
    var password = '';
    for (var i = 0; i < length; i++) {
      password += chars.charAt(Math.floor(Math.random() * chars.length));
    }
    return password;
  }

  function generateAndShowPassword() {
    tempPassword = generatePasswordClient(10);
    document.getElementById('user-display-password').value = tempPassword;
  }

  function editUser(rowIndex) {
    var user = allUsers.find(function(u) { return u.rowIndex === rowIndex; });
    if (!user) return;
    
    document.getElementById('user-modal-title').textContent = 'Edit User';
    document.getElementById('user-row-index').value = user.rowIndex;
    document.getElementById('user-name').value = user['Nama Lengkap'] || '';
    document.getElementById('user-username').value = user.Username || '';
    document.getElementById('user-email').value = user.Email || '';
    document.getElementById('user-phone').value = user['No Telepon'] || '';
    document.getElementById('user-telegram').value = user['Telegram ID'] || '';
    document.getElementById('user-role').value = user.Role || '';
    document.getElementById('user-status').value = user.Status || 'Aktif';
    document.getElementById('user-display-password').value = '****** (Gunakan Reset Password untuk mengubah)';
    tempPassword = '';
    document.getElementById('user-modal').classList.remove('hidden');
    document.getElementById('user-modal').classList.add('flex');
  }

  function closeUserModal() {
    document.getElementById('user-modal').classList.add('hidden');
    document.getElementById('user-modal').classList.remove('flex');
  }

  // ✅ REVISI 3: Loading page muncul PALING AWAL, sebelum proses apapun
  function saveUser(e) {
    e.preventDefault();
    if (typeof showLoading === 'function') showLoading('Menyimpan data user...');
    
    var rowIndex = document.getElementById('user-row-index').value;
    var userData = {
      'Nama Lengkap': document.getElementById('user-name').value.trim(),
      'Username': document.getElementById('user-username').value.trim(),
      'Email': document.getElementById('user-email').value.trim(),
      'No Telepon': document.getElementById('user-phone').value.trim(),
      'Telegram ID': document.getElementById('user-telegram').value.trim(),
      'Role': document.getElementById('user-role').value,
      'Status': document.getElementById('user-status').value,
      'TempPassword': tempPassword
    };
    
    var onSuccess = function(res) {
      if (typeof hideLoading === 'function') hideLoading();
      if (res && res.success) {
        closeUserModal();
        setTimeout(function() {
          loadUsers();
          if (typeof showToast === 'function') showToast(res.message, 'success');
        }, 100);
      } else {
        if (typeof showToast === 'function') showToast(res && res.message ? res.message : 'Gagal menyimpan', 'error');
      }
    };
    
    if (rowIndex) {
      google.script.run.withSuccessHandler(onSuccess).updateUser(parseInt(rowIndex), userData);
    } else {
      google.script.run.withSuccessHandler(onSuccess).createUser(userData);
    }
  }

  // ✅ REVISI 2: Fungsi untuk membuka modal reset password yang bagus
  function openResetPasswordModal(rowIndex) {
    var user = allUsers.find(function(u) { return u.rowIndex === rowIndex; });
    if (!user) return;
    
    resetPasswordRowIndex = rowIndex;
    document.getElementById('reset-password-email-display').textContent = user.Email || 'Email tidak tersedia';
    document.getElementById('reset-password-modal').classList.remove('hidden');
    document.getElementById('reset-password-modal').classList.add('flex');
  }

  function closeResetPasswordModal() {
    document.getElementById('reset-password-modal').classList.add('hidden');
    document.getElementById('reset-password-modal').classList.remove('flex');
    resetPasswordRowIndex = null;
  }

  function confirmResetPassword() {
    if (!resetPasswordRowIndex) return;
    
    if (typeof showLoading === 'function') showLoading('Memproses reset password...');
    closeResetPasswordModal();
    
    google.script.run
      .withSuccessHandler(function(res) {
        if (typeof hideLoading === 'function') hideLoading();
        if (res && res.success) {
          if (typeof showToast === 'function') showToast('Password baru telah dikirim ke email pengguna', 'success');
        } else {
          if (typeof showToast === 'function') showToast(res && res.message ? res.message : 'Gagal reset', 'error');
        }
      })
      .withFailureHandler(function(err) {
        if (typeof hideLoading === 'function') hideLoading();
        if (typeof showToast === 'function') showToast('Error: ' + err.toString(), 'error');
      })
      .resetUserPassword(resetPasswordRowIndex);
  }

  // Event Listeners untuk menutup modal saat klik di luar area modal
  var userModal = document.getElementById('user-modal');
  if (userModal) {
    userModal.addEventListener('click', function(e) { if (e.target === this) closeUserModal(); });
  }
  var resetPwModal = document.getElementById('reset-password-modal');
  if (resetPwModal) {
    resetPwModal.addEventListener('click', function(e) { if (e.target === this) closeResetPasswordModal(); });
  }

  console.log('=== config-user.html script loaded (Clean Version) ===');
</script>
