function saveMenuConfig(menuConfig) {
  try {
    var currentUser = validateSession();
    if (currentUser.role !== 'Superadmin') {
      return { success: false, message: 'Hanya Superadmin yang dapat mengubah menu' };
    }
    
    // Simpan ke Properties Service
    PropertiesService.getUserProperties().setProperty('menuConfig', JSON.stringify(menuConfig));
    
    return { success: true, message: 'Menu berhasil disimpan' };
  } catch (e) {
    return { success: false, message: 'Error: ' + e.toString() };
  }
}

function getMenuConfig() {
  try {
    var config = PropertiesService.getUserProperties().getProperty('menuConfig');
    if (config) {
      return { success: true, config: JSON.parse(config) };
    }
    return { success: true, config: getMainMenuConfig() };
  } catch (e) {
    return { success: false, message: 'Error: ' + e.toString() };
  }
}

function getMenusByRole(role) {
  var config = getMenuConfig();
  var menuConfig = config.success ? config.config : getMainMenuConfig();
  
  var menus = {
    'Superadmin': {
      main: menuConfig.main,
      reporting: menuConfig.reporting,
      configuration: menuConfig.configuration
    },
    'Manager': {
      main: menuConfig.main.filter(m => m.id !== 'config-users'),
      reporting: menuConfig.reporting
    },
    'PIC': {
      main: menuConfig.main.filter(m => m.id !== 'repository'),
      reporting: menuConfig.reporting.filter(m => m.id === 'team-okr')
    },
    'Viewer': {
      main: menuConfig.main.filter(m => m.id === 'dashboard'),
      reporting: []
    }
  };
  
  return menus[role] || { main: menuConfig.main.filter(m => m.id === 'dashboard'), reporting: [] };
}

