function getAllUsers() {
  try {
    var sheet = getUsersSheet();
    var data = sheet.getDataRange().getValues();
    if (data.length <= 1) return { success: true, users: [] };
    
    var headers = data[0];
    var users = [];
    for (var i = 1; i < data.length; i++) {
      var user = { rowIndex: i + 1 };
      for (var j = 0; j < headers.length; j++) {
        var val = data[i][j];
        if (val instanceof Date) {
          user[headers[j]] = Utilities.formatDate(val, Session.getScriptTimeZone(), "dd MMM yyyy");
        } else {
          user[headers[j]] = val;
        }
      }
      users.push(user);
    }
    return { success: true, users: users };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

function createUser(userData) {
  try {
    var currentUser = validateSession();
    if (currentUser.role !== 'Superadmin') return { success: false, message: 'Akses ditolak' };
    
    var sheet = getUsersSheet();
    var data = sheet.getDataRange().getValues();
    var headers = data[0];
    
    var userCol = headers.indexOf('Username');
    var emailCol = headers.indexOf('Email');
    for (var i = 1; i < data.length; i++) {
      if (data[i][userCol].toString().toLowerCase() === userData.Username.toLowerCase()) {
        return { success: false, message: 'Username sudah digunakan!' };
      }
      if (data[i][emailCol].toString().toLowerCase() === userData.Email.toLowerCase()) {
        return { success: false, message: 'Email sudah terdaftar!' };
      }
    }
    
    var newPassword = generatePassword(10);
    var today = Utilities.formatDate(new Date(), Session.getScriptTimeZone(), "dd MMM yyyy");
    
    // Urutan kolom sesuai sheet: Nama, Username, Email, Password, No Telp, Telegram, Role, Status, Foto, Tanggal
    var newRow = [
      userData['Nama Lengkap'],
      userData.Username,
      userData.Email,
      newPassword,
      userData['No Telepon'] || '',
      userData['Telegram ID'] || '',
      userData.Role || 'PIC',
      userData.Status || 'Aktif',
      '', // Foto Profil
      today
    ];
    
    sheet.appendRow(newRow);
    sendWelcomeEmail(userData.Email, userData['Nama Lengkap'], userData.Username, newPassword);
    
    return { success: true, message: 'User berhasil dibuat & email telah dikirim' };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

function updateUser(rowIndex, userData) {
  try {
    var currentUser = validateSession();
    if (currentUser.role !== 'Superadmin') return { success: false, message: 'Akses ditolak' };
    
    var sheet = getUsersSheet();
    var data = sheet.getDataRange().getValues();
    var headers = data[0];
    
    var userCol = headers.indexOf('Username');
    var emailCol = headers.indexOf('Email');
    for (var i = 1; i < data.length; i++) {
      if (i + 1 === rowIndex) continue;
      if (data[i][userCol].toString().toLowerCase() === userData.Username.toLowerCase()) {
        return { success: false, message: 'Username sudah digunakan user lain!' };
      }
      if (data[i][emailCol].toString().toLowerCase() === userData.Email.toLowerCase()) {
        return { success: false, message: 'Email sudah digunakan user lain!' };
      }
    }
    
    var updateMap = {
      'Nama Lengkap': userData['Nama Lengkap'],
      'Username': userData.Username,
      'Email': userData.Email,
      'No Telepon': userData['No Telepon'],
      'Telegram ID': userData['Telegram ID'],
      'Role': userData.Role,
      'Status': userData.Status
    };
    
    for (var key in updateMap) {
      var colIndex = headers.indexOf(key);
      if (colIndex !== -1) {
        sheet.getRange(rowIndex, colIndex + 1).setValue(updateMap[key]);
      }
    }
    
    return { success: true, message: 'User berhasil diupdate' };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

function deleteUser(rowIndex) {
  try {
    var currentUser = validateSession();
    if (currentUser.role !== 'Superadmin') return { success: false, message: 'Akses ditolak' };
    
    var sheet = getUsersSheet();
    if (rowIndex < 2 || rowIndex > sheet.getLastRow()) {
      return { success: false, message: 'Row tidak valid' };
    }
    
    sheet.deleteRow(rowIndex);
    return { success: true, message: 'User berhasil dihapus' };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

function resetUserPassword(rowIndex) {
  try {
    var currentUser = validateSession();
    if (currentUser.role !== 'Superadmin') return { success: false, message: 'Akses ditolak' };
    
    var sheet = getUsersSheet();
    var data = sheet.getDataRange().getValues();
    var headers = data[0];
    
    var passCol = headers.indexOf('Password');
    var emailCol = headers.indexOf('Email');
    var nameCol = headers.indexOf('Nama Lengkap');
    var userCol = headers.indexOf('Username');
    
    var newPassword = generatePassword(10);
    sheet.getRange(rowIndex, passCol + 1).setValue(newPassword);
    
    var email = data[rowIndex - 1][emailCol];
    var name = data[rowIndex - 1][nameCol];
    var username = data[rowIndex - 1][userCol];
    
    sendWelcomeEmail(email, name, username, newPassword);
    
    return { success: true, message: 'Password direset & email baru telah dikirim' };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

function updateMyProfile(userData, photoUrl) {
  try {
    var currentUser = validateSession();
    var sheet = getUsersSheet();
    var headers = sheet.getRange(1, 1, 1, sheet.getLastColumn()).getValues()[0];
    
    var rowIndex = currentUser.rowIndex;
    
    if (userData['Nama Lengkap']) sheet.getRange(rowIndex, headers.indexOf('Nama Lengkap') + 1).setValue(userData['Nama Lengkap']);
    if (userData['No Telepon']) sheet.getRange(rowIndex, headers.indexOf('No Telepon') + 1).setValue(userData['No Telepon']);
    if (userData['Telegram ID']) sheet.getRange(rowIndex, headers.indexOf('Telegram ID') + 1).setValue(userData['Telegram ID']);
    
    if (photoUrl) {
      var photoCol = headers.indexOf('Foto Profil');
      sheet.getRange(rowIndex, photoCol + 1).setValue(photoUrl);
    }
    
    currentUser.name = userData['Nama Lengkap'] || currentUser.name;
    currentUser.photo = photoUrl || currentUser.photo;
    PropertiesService.getUserProperties().setProperty('currentUser', JSON.stringify(currentUser));
    
    return { success: true, message: 'Profil berhasil diupdate', user: currentUser };
  } catch (e) {
    return { success: false, message: e.toString() };
  }
}

