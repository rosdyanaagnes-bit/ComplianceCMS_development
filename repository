var currentDeleteContext = null;

window.initRepositoryPage = function(pageId) {
  if (pageId === 'repo-policy') loadPolicyData();
  else if (pageId === 'repo-bi') loadBIData();
  else if (pageId === 'repo-directory') loadDirectoryData();
};

// ============================================
// POLICY FUNCTIONS
// ============================================
function loadPolicyData() {
  google.script.run.withSuccessHandler(function(res) {
    if (res && res.success) {
      policyData = res.documents || [];
      document.getElementById('policy-search').value = '';
      document.getElementById('policy-date-from').value = '';
      document.getElementById('policy-date-to').value = '';
      document.getElementById('policy-filter-status').value = '';
      renderPolicyTable(policyData);
      updatePolicyStats();
    }
  }).getRepoData('repo-policy');
}

function updatePolicyStats() {
  document.getElementById('policy-stat-total').textContent = policyData.length;
  document.getElementById('policy-stat-active').textContent = policyData.filter(function(d) { return d.Status === 'Active'; }).length;
  document.getElementById('policy-stat-obsolete').textContent = policyData.filter(function(d) { return d.Status === 'Obsolete'; }).length;
}

function renderPolicyTable(data) {
  var tbody = document.getElementById('policy-table-body');
  if (!tbody) return;
  tbody.innerHTML = '';
  if (data.length === 0) {
    tbody.innerHTML = '<tr><td colspan="10" class="p-8 text-center text-slate-400">No documents found</td></tr>';
    return;
  }
  data.forEach(function(doc, index) {
    var statusClass = doc.Status === 'Active' ? 'bg-green-500/20 text-green-400' : 'bg-red-500/20 text-red-400';
    var typeBadge = doc.DocType ? '<span class="inline-block px-2 py-1 bg-[#9d4edd]/20 text-[#9d4edd] border border-[#9d4edd]/30 rounded text-xs font-semibold">' + doc.DocType + '</span>' : '-';
    var row = document.createElement('tr');
    row.className = 'hover:bg-white/5 transition-colors';
    row.innerHTML = '<td class="p-4 text-sm text-slate-300">' + (index + 1) + '</td>' +
      '<td class="p-4 text-sm text-white font-medium truncate" title="' + (doc.DocumentName || '') + '">' + (doc.DocumentName || '-') + '</td>' +
      '<td class="p-4">' + typeBadge + '</td>' +
      '<td class="p-4 text-sm text-slate-300 font-mono">' + (doc.DocNumber || '-') + '</td>' +
      '<td class="p-4 text-sm text-slate-300">' + (doc.Department || '-') + '</td>' +
      '<td class="p-4 text-sm text-slate-300">' + (doc.Owner || '-') + '</td>' +
      '<td class="p-4"><span class="px-2 py-1 rounded text-xs font-semibold ' + statusClass + '">' + (doc.Status || '-') + '</span></td>' +
      '<td class="p-4 text-sm text-slate-300 whitespace-nowrap">' + (doc.EffectiveDate || '-') + '</td>' +
      '<td class="p-4 text-sm text-slate-400 whitespace-nowrap">' + (doc.CreatedDate || '-') + '</td>' +
      '<td class="p-4 text-right"><div class="flex justify-end gap-1">' +
        (doc.DriveLink ? '<a href="' + doc.DriveLink + '" target="_blank" class="p-2 text-[#00d4aa] hover:bg-[#00d4aa]/10 rounded-lg" title="Download"><span class="material-symbols-outlined text-[18px]">download</span></a>' : '') +
        '<button onclick="editPolicyDoc(' + doc.rowIndex + ')" class="p-2 text-[#9d4edd] hover:bg-[#9d4edd]/10 rounded-lg" title="Edit"><span class="material-symbols-outlined text-[18px]">edit</span></button>' +
      '</div></td>';
    tbody.appendChild(row);
  });
}

function filterPolicyData() {
  var search = document.getElementById('policy-search').value.toLowerCase();
  var dateFrom = document.getElementById('policy-date-from').value;
  var dateTo = document.getElementById('policy-date-to').value;
  var statusFilter = document.getElementById('policy-filter-status').value;
  var filtered = policyData.filter(function(doc) {
    var matchSearch = !search || (doc.DocumentName && doc.DocumentName.toLowerCase().includes(search)) || (doc.DocNumber && doc.DocNumber.toLowerCase().includes(search));
    var matchStatus = !statusFilter || doc.Status === statusFilter;
    var matchDate = true;
    if (dateFrom || dateTo) {
      var createdDate = doc.CreatedDate;
      if (createdDate) {
        var dateObj = parseCustomDate(createdDate);
        if (dateObj) {
          if (dateFrom && dateObj < new Date(dateFrom)) matchDate = false;
          if (dateTo && dateObj > new Date(dateTo + 'T23:59:59')) matchDate = false;
        } else { matchDate = false; }
      } else { matchDate = false; }
    }
    return matchSearch && matchStatus && matchDate;
  });
  renderPolicyTable(filtered);
}

function parseCustomDate(dateStr) {
  var months = { 'Jan': 0, 'Feb': 1, 'Mar': 2, 'Apr': 3, 'May': 4, 'Jun': 5, 'Jul': 6, 'Aug': 7, 'Sep': 8, 'Oct': 9, 'Nov': 10, 'Dec': 11 };
  var parts = dateStr.split(' ');
  if (parts.length === 3) {
    var day = parseInt(parts[0]), month = months[parts[1]], year = parseInt(parts[2]);
    if (!isNaN(day) && !isNaN(year) && month !== undefined) return new Date(year, month, day);
  }
  return null;
}

