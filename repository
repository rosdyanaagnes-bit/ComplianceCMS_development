<!-- MODALS -->
<div id="policy-modal" class="fixed inset-0 z-[10000] hidden">
  <div class="fixed inset-0 bg-black/70 backdrop-blur-sm" onclick="closePolicyModal()"></div>
  <div class="fixed inset-0 flex items-center justify-center p-4 pointer-events-none">
    <div class="glass rounded-2xl shadow-2xl max-w-3xl w-full border border-white/10 max-h-[90vh] overflow-y-auto pointer-events-auto bg-[#1e2745]">
      <div class="border-b border-white/10 p-6 flex justify-between items-center">
        <h2 class="text-2xl font-bold text-white" id="policy-modal-title">Add Document</h2>
        <button onclick="closePolicyModal()" class="p-2 hover:bg-white/10 rounded-lg transition">
          <span class="material-symbols-outlined text-slate-400">close</span>
        </button>
      </div>
      <form id="policy-form" onsubmit="savePolicyDocument(event)" class="p-6">
        <input type="hidden" id="policy-row-index">
        <div class="space-y-4">
          <div>
            <label class="block text-sm font-semibold text-slate-300 mb-2">Document Name *</label>
            <input type="text" id="policy-docname" required class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa]">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-300 mb-2">Document Number *</label>
            <input type="text" id="policy-docnumber" required class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa]">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-300 mb-2">Department *</label>
            <input type="text" id="policy-department" required class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa]">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-300 mb-2">Owner *</label>
            <input type="text" id="policy-owner" required class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa]">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-300 mb-2">Status *</label>
            <select id="policy-status" required class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa]">
              <option value="Active">Active</option>
              <option value="Obsolete">Obsolete</option>
            </select>
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-300 mb-2">Effective Date *</label>
            <input type="date" id="policy-effectivedate" required class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa]">
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-300 mb-2">Google Drive Link *</label>
            <input type="url" id="policy-drivelink" required class="w-full px-4 py-3 bg-black/20 border border-white/10 rounded-lg text-white focus:outline-none focus:ring-2 focus:ring-[#00d4aa]" placeholder="https://drive.google.com/...">
          </div>
        </div>
        <div class="mt-6 flex gap-3">
          <button type="button" onclick="closePolicyModal()" class="flex-1 py-3 rounded-lg font-semibold text-slate-300 bg-white/5 hover:bg-white/10 border border-white/10 transition">Cancel</button>
          <button type="submit" class="flex-1 py-3 rounded-lg font-semibold text-white bg-gradient-to-r from-[#00d4aa] to-[#9d4edd] hover:opacity-90 transition">Save Document</button>
        </div>
      </form>
    </div>
  </div>
</div>

