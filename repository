      '<td class="p-4 text-sm text-white font-medium truncate" title="' + (doc.NameDocument || '') + '">' + (doc.NameDocument || '-') + '</td>' +
      '<td class="p-4 text-sm text-slate-300 truncate max-w-xs">' + (doc.Description || '-') + '</td>' +
      '<td class="p-4"><span class="px-2 py-1 rounded text-xs font-semibold ' + statusClass + '">' + (doc.Status || '-') + '</span></td>' +
      '<td class="p-4 text-sm text-slate-400 whitespace-nowrap">' + (doc.CreatedDate || '-') + '</td>' +
      '<td class="p-4 text-right"><div class="flex justify-end gap-1">' +
        (doc.DriveLink ? '<a href="' + doc.DriveLink + '" target="_blank" class="p-2 text-[#00d4aa] hover:bg-[#00d4aa]/10 rounded-lg" title="Download"><span class="material-symbols-outlined text-[18px]">download</span></a>' : '') +
        '<button onclick="editDirectoryDoc(' + doc.rowIndex + ')" class="p-2 text-[#9d4edd] hover:bg-[#9d4edd]/10 rounded-lg" title="Edit"><span class="material-symbols-outlined text-[18px]">edit</span></button>' +
      '</div></td>';
    tbody.appendChild(row);
  });
}

function filterDirectoryData() {
  var search = document.getElementById('directory-search').value.toLowerCase();
  var dateFrom = document.getElementById('directory-date-from').value;
  var dateTo = document.getElementById('directory-date-to').value;
  var statusFilter = document.getElementById('directory-filter-status').value;
  var filtered = directoryData.filter(function(doc) {
    var matchSearch = !search || (doc.NameDocument && doc.NameDocument.toLowerCase().includes(search)) || (doc.NumberDoc && doc.NumberDoc.toLowerCase().includes(search));
    var matchStatus = !statusFilter || doc.Status === statusFilter;
    var matchDate = true;
    if (dateFrom || dateTo) {
      var createdDate = doc.CreatedDate;
      if (createdDate) {
        var dateObj = parseCustomDate(createdDate);
        if (dateObj) {
          if (dateFrom && dateObj < new Date(dateFrom)) matchDate = false;
          if (dateTo && dateObj > new Date(dateTo + 'T23:59:59')) matchDate = false;
        } else { matchDate = false; }
      } else { matchDate = false; }
    }
    return matchSearch && matchStatus && matchDate;
  });
  renderDirectoryTable(filtered);
}

function openDirectoryModal() {
  document.getElementById('directory-modal-title').textContent = 'Add Directory Document';
  document.getElementById('directory-form').reset();
  document.getElementById('directory-row-index').value = '';
  document.getElementById('btn-delete-directory').classList.add('hidden');
  document.getElementById('directory-modal').classList.remove('hidden');
}
function closeDirectoryModal() { document.getElementById('directory-modal').classList.add('hidden'); }

function editDirectoryDoc(rowIndex) {
  var doc = directoryData.find(function(d) { return d.rowIndex === rowIndex; });
  if (!doc) return;
  document.getElementById('directory-modal-title').textContent = 'Edit Directory Document';
  document.getElementById('directory-row-index').value = doc.rowIndex;
  document.getElementById('directory-numberdoc').value = doc.NumberDoc || '';
  document.getElementById('directory-namedoc').value = doc.NameDocument || '';
  document.getElementById('directory-description').value = doc.Description || '';
  document.getElementById('directory-status').value = doc.Status || 'Active';
  document.getElementById('directory-drivelink').value = doc.DriveLink || '';
  document.getElementById('btn-delete-directory').classList.remove('hidden');
  document.getElementById('directory-modal').classList.remove('hidden');
}

function saveDirectoryDocument(e) {
  e.preventDefault();
  if (typeof showLoading === 'function') showLoading('Saving document...');
  var rowIndex = document.getElementById('directory-row-index').value;
  var docData = {
    NumberDoc: document.getElementById('directory-numberdoc').value,
    NameDocument: document.getElementById('directory-namedoc').value,
    Description: document.getElementById('directory-description').value,
    Status: document.getElementById('directory-status').value,
    DriveLink: document.getElementById('directory-drivelink').value
  };
  google.script.run
    .withSuccessHandler(function(res) {
      if (typeof hideLoading === 'function') hideLoading();
      if (res && res.success) { closeDirectoryModal(); loadDirectoryData(); if (typeof showToast === 'function') showToast(res.message, 'success'); }
      else { if (typeof showToast === 'function') showToast(res.message || 'Failed', 'error'); }
    })
    .withFailureHandler(function(err) {
      if (typeof hideLoading === 'function') hideLoading();
      if (typeof showToast === 'function') showToast('Error: ' + err.toString(), 'error');
    })
    .saveRepoDocument('repo-directory', rowIndex, docData);
}

function deleteDirectoryFromModal() {
  var rowIndex = document.getElementById('directory-row-index').value;
  if (!rowIndex) return;
  var doc = directoryData.find(function(d) { return d.rowIndex == rowIndex; });
  closeDirectoryModal();
  showRepoDeleteConfirm('directory', rowIndex, doc ? (doc.NameDocument || '-') : '-', 'Directory', doc ? (doc.Status || '-') : '-');
}

// ============================================
// REUSABLE DELETE CONFIRMATION
// ============================================
function showRepoDeleteConfirm(type, rowIndex, name, docType, status) {
  currentDeleteContext = { type: type, rowIndex: rowIndex };
  document.getElementById('repo-delete-doc-name').textContent = name;
  document.getElementById('repo-delete-doc-type').textContent = docType;
  document.getElementById('repo-delete-doc-status').textContent = status;
  document.getElementById('repo-delete-confirm-modal').classList.remove('hidden');
}

function closeRepoDeleteModal() {
  document.getElementById('repo-delete-confirm-modal').classList.add('hidden');
  currentDeleteContext = null;
}

function confirmRepoDelete() {
  if (!currentDeleteContext) return;
  var type = currentDeleteContext.type;
  var rowIndex = currentDeleteContext.rowIndex;
  
  if (typeof showLoading === 'function') showLoading('Deleting document...');
  closeRepoDeleteModal();
  
  google.script.run
    .withSuccessHandler(function(res) {
      if (typeof hideLoading === 'function') hideLoading();
      if (res && res.success) {
        if (type === 'policy') loadPolicyData();
        else if (type === 'bi') loadBIData();
        else if (type === 'directory') loadDirectoryData();
        if (typeof showToast === 'function') showToast('Document deleted successfully', 'success');
      } else {
        if (typeof showToast === 'function') showToast(res.message || 'Failed to delete', 'error');
      }
    })
    .withFailureHandler(function(err) {
      if (typeof hideLoading === 'function') hideLoading();
      if (typeof showToast === 'function') showToast('Error: ' + err.toString(), 'error');
    })
    .deleteRepoDocument(type, parseInt(rowIndex));
}

