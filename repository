    Status: document.getElementById('policy-status').value,
    EffectiveDate: document.getElementById('policy-effectivedate').value,
    DriveLink: document.getElementById('policy-drivelink').value
  };
  google.script.run
    .withSuccessHandler(function(res) {
      if (typeof hideLoading === 'function') hideLoading();
      if (res && res.success) { closePolicyModal(); loadPolicyData(); if (typeof showToast === 'function') showToast(res.message, 'success'); }
      else { if (typeof showToast === 'function') showToast(res.message || 'Failed', 'error'); }
